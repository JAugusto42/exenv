#!/usr/bin/env bash

set -e

if [ -z "$EXENV_ROOT" ]; then
  export EXENV_ROOT="${HOME}/.exenv"
fi

# --- HELPER FUNCTIONS ---

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

download_with_curl() {
  local url="$1"
  local output="$2"
  curl -L --fail --silent --show-error -o "$output" "$url"
}

download_with_wget() {
  local url="$1"
  local output="$2"
  wget -q -O "$output" "$url"
}

download_file() {
  local url="$1"
  local output="$2"

  if command_exists curl; then
    download_with_curl "$url" "$output"
  elif command_exists wget; then
    download_with_wget "$url" "$output"
  else
    return 1
  fi
}

check_url_exists() {
  local url="$1"
  if command_exists curl; then
    curl --head --silent --fail -L "$url" >/dev/null 2>&1
    return $?
  elif command_exists wget; then
    wget --spider -q "$url" >/dev/null 2>&1
    return $?
  fi
  return 1
}

find_local_version_file() {
  local dir="$PWD"

  while [ "$dir" != "/" ]; do
    if [ -f "$dir/.elixir-version" ]; then
      printf '%s' "$dir/.elixir-version"
      return 0
    fi
    dir="$(dirname "$dir")"
  done

  return 1
}

find_elixir_archive() {
  local version="$1"
  local -a otp_candidates=(29 28 27 26 25 24 23 22 21)
  local filename
  local url

  for otp in "${otp_candidates[@]}"; do
    filename="elixir-otp-${otp}.zip"
    url="https://github.com/elixir-lang/elixir/releases/download/v${version}/${filename}"
    if check_url_exists "$url"; then
      printf '%s' "$filename"
      return 0
    fi
  done

  return 1
}

detect_shell() {
  if [ -n "$ZSH_VERSION" ]; then
    printf '%s' "zsh"
  elif [ -n "$BASH_VERSION" ]; then
    printf '%s' "bash"
  elif [ -n "$KSH_VERSION" ]; then
    printf '%s' "sh"
  elif [ -n "$SHELL" ]; then
    case "${SHELL##*/}" in
      bash|zsh|sh)
        printf '%s' "${SHELL##*/}"
        ;;
      *)
        printf '%s' "sh"
        ;;
    esac
  else
    printf '%s' "sh"
  fi
}

output_init_script() {
  cat <<'EOF'
export EXENV_ROOT="${HOME}/.exenv"
export PATH="$EXENV_ROOT/bin:$EXENV_ROOT/shims:$PATH"
EOF
}

get_active_version() {
  local version
  local version_file

  version_file="$(find_local_version_file)" || true
  if [ -n "$version_file" ]; then
    version="$(cat "$version_file")"
  elif [ -f "${EXENV_ROOT}/version" ]; then
    version="$(cat "${EXENV_ROOT}/version")"
  fi

  printf '%s' "$version"
}

list_remote_versions() {
  local url="https://api.github.com/repos/elixir-lang/elixir/tags?per_page=100"
  local tmpfile

  if ! command_exists curl && ! command_exists wget; then
    echo "Error: 'curl' or 'wget' is required to fetch remote version data."
    return 1
  fi

  tmpfile="$(mktemp /tmp/exenv-releases.XXXXXX)"
  trap 'rm -f "$tmpfile"' EXIT

  if ! download_file "$url" "$tmpfile"; then
    echo "Error: Failed to fetch remote tag information."
    return 1
  fi

  grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"' "$tmpfile" \
    | sed -E 's/.*"([^"]+)"/\1/' \
    | sed 's/^v//' \
    | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' \
    | sort -t. -k1,1n -k2,2n -k3,3n -u

  trap - EXIT
}

exenv_rehash() {
  echo "Rebuilding shims..."
  rm -rf "${EXENV_ROOT}/shims"
  mkdir -p "${EXENV_ROOT}/shims"

  for version_path in "${EXENV_ROOT}/versions"/*; do
    if [ -d "${version_path}/bin" ]; then
      for executable in "${version_path}/bin"/*; do
        local fname
        fname=$(basename "$executable")
        echo "#!/usr/bin/env bash" > "${EXENV_ROOT}/shims/${fname}"
        echo "exec exenv exec ${fname} \"\$@\"" >> "${EXENV_ROOT}/shims/${fname}"
        chmod +x "${EXENV_ROOT}/shims/${fname}"
      done
    fi
  done
  echo "Shims rebuilt."
}

# --- COMMANDS ---

case "$1" in
  init)
    if [ "$2" = "-" ] || [ -z "$2" ]; then
      shell_name="$(detect_shell)"
    else
      shell_name="$2"
    fi

    case "$shell_name" in
      bash|zsh|sh)
        output_init_script
        ;;
      *)
        echo "Error: Unsupported shell '$shell_name'. Supported: bash, zsh, sh." >&2
        exit 1
        ;;
    esac
    ;;

  install)
    if [ "$2" = "--list" ] || [ "$2" = "-l" ]; then
      list_remote_versions
      exit $?
    fi

    VERSION="$2"
    if [ -z "$VERSION" ]; then
      echo "Error: Please provide a version to install. Ex: exenv install 1.16.2"
      exit 1
    fi

    if ! command_exists unzip; then
      echo "Error: 'unzip' is required to extract Elixir archives."
      exit 1
    fi

    INSTALL_PATH="${EXENV_ROOT}/versions/${VERSION}"
    if [ -d "$INSTALL_PATH" ]; then
      echo "Version ${VERSION} is already installed."
      exit 0
    fi

    ARCHIVE_NAME="$(find_elixir_archive "$VERSION")"
    if [ -z "$ARCHIVE_NAME" ]; then
      echo "Error: Could not find a prebuilt Elixir OTP archive for version ${VERSION}."
      exit 1
    fi

    URL="https://github.com/elixir-lang/elixir/releases/download/v${VERSION}/${ARCHIVE_NAME}"
    echo "Downloading Elixir v${VERSION} (${ARCHIVE_NAME})..."

    TMPFILE="$(mktemp /tmp/exenv-elixir.XXXXXX.zip)"
    trap 'rm -f "$TMPFILE"' EXIT
    if ! download_file "$URL" "$TMPFILE"; then
      echo "Error: Failed to download ${URL}."
      exit 1
    fi

    echo "Installing Elixir v${VERSION} to ${INSTALL_PATH}..."
    mkdir -p "$INSTALL_PATH"
    unzip -q "$TMPFILE" -d "$INSTALL_PATH"
    rm -f "$TMPFILE"
    trap - EXIT

    if [ -d "$INSTALL_PATH/bin" ]; then
      chmod +x "$INSTALL_PATH/bin"/* 2>/dev/null || true
    fi

    echo "Elixir v${VERSION} installed successfully."
    exenv_rehash
    ;;

  versions)
    echo "Installed versions:"
    ls -1 "${EXENV_ROOT}/versions"
    ;;

  list-remote)
    echo "Available remote versions:"
    list_remote_versions
    ;;

  global)
    VERSION="$2"
    if [ -z "$VERSION" ]; then
      echo "Error: Please provide a version to set as global."
      exit 1
    fi
    echo "Setting global version to ${VERSION}..."
    echo "$VERSION" > "${EXENV_ROOT}/version"
    ;;

  local)
    VERSION="$2"
    if [ -z "$VERSION" ]; then
      echo "Error: Please provide a version to set as local."
      exit 1
    fi
    echo "Setting local version to ${VERSION}..."
    echo "$VERSION" > ".elixir-version"
    ;;

  uninstall)
    VERSION="$2"
    if [ -z "$VERSION" ]; then
      echo "Error: Please provide a version to uninstall. Ex: exenv uninstall 1.16.2"
      exit 1
    fi

    INSTALL_PATH="${EXENV_ROOT}/versions/${VERSION}"
    if [ ! -d "$INSTALL_PATH" ]; then
      echo "Version ${VERSION} is not installed."
      exit 1
    fi

    rm -rf "$INSTALL_PATH"
    echo "Version ${VERSION} has been removed."
    exenv_rehash
    ;;

  which)
    COMMAND_NAME="$2"
    if [ -z "$COMMAND_NAME" ]; then
      echo "Error: Please provide a command name. Ex: exenv which elixir"
      exit 1
    fi

    VERSION="$(get_active_version)"
    if [ -z "$VERSION" ]; then
      echo "No Elixir version has been set. Use 'exenv global <version>'."
      exit 1
    fi

    REAL_EXECUTABLE="${EXENV_ROOT}/versions/${VERSION}/bin/${COMMAND_NAME}"
    if [ -x "$REAL_EXECUTABLE" ]; then
      echo "$REAL_EXECUTABLE"
    else
      echo "Error: Command '${COMMAND_NAME}' not found for version ${VERSION}."
      exit 1
    fi
    ;;

  version)
    VERSION="$(get_active_version)"
    if [ -z "$VERSION" ]; then
      echo "No Elixir version has been set. Use 'exenv global <version>'."
      exit 1
    fi
    echo "$VERSION"
    ;;

  rehash)
    exenv_rehash
    ;;

  exec)
    COMMAND_NAME="$2"
    shift 2

    VERSION_FILE="$(find_local_version_file)"
    if [ -n "$VERSION_FILE" ]; then
      VERSION="$(cat "$VERSION_FILE")"
    elif [ -f "${EXENV_ROOT}/version" ]; then
      VERSION="$(cat "${EXENV_ROOT}/version")"
    fi

    if [ -z "$VERSION" ]; then
      echo "No Elixir version has been set. Use 'exenv global <version>'."
      exit 1
    fi

    REAL_EXECUTABLE="${EXENV_ROOT}/versions/${VERSION}/bin/${COMMAND_NAME}"
    if [ -f "$REAL_EXECUTABLE" ]; then
      exec "$REAL_EXECUTABLE" "$@"
    else
      echo "Error: Command '${COMMAND_NAME}' not found in version ${VERSION}."
      exit 1
    fi
    ;;

  *)
    echo "Usage: exenv <command> [<options>]"
    echo "Commands:"
    echo "  init [-|bash|zsh|sh] - Outputs shell init code for exenv"
    echo "  install <version>    - Installs a version of Elixir"
    echo "  install --list       - Lists available remote Elixir versions"
    echo "  versions             - Lists installed versions"
    echo "  list-remote          - Lists available remote Elixir versions"
    echo "  uninstall <version>  - Removes an installed Elixir version"
    echo "  global <version>     - Sets the global version"
    echo "  local <version>      - Sets the local version (for the current directory)"
    echo "  version              - Shows the active Elixir version"
    echo "  which <command>      - Shows the full path of a command for the active version"
    echo "  rehash               - Rebuilds the shims"
    ;;
esac
