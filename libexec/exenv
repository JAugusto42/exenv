#!/usr/bin/env bash

set -e

if [ -z "$EXENV_ROOT" ]; then
  export EXENV_ROOT="${HOME}/.exenv"
fi

# --- HELPER FUNCTIONS ---

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

download_with_curl() {
  local url="$1"
  local output="$2"
  curl -L --fail --silent --show-error -o "$output" "$url"
}

download_with_wget() {
  local url="$1"
  local output="$2"
  wget -q -O "$output" "$url"
}

download_file() {
  local url="$1"
  local output="$2"

  if command_exists curl; then
    download_with_curl "$url" "$output"
  elif command_exists wget; then
    download_with_wget "$url" "$output"
  else
    return 1
  fi
}

check_url_exists() {
  local url="$1"
  if command_exists curl; then
    curl --head --silent --fail -L "$url" >/dev/null 2>&1
    return $?
  elif command_exists wget; then
    wget --spider -q "$url" >/dev/null 2>&1
    return $?
  fi
  return 1
}

find_local_version_file() {
  local dir="$PWD"

  while [ "$dir" != "/" ]; do
    if [ -f "$dir/.elixir-version" ]; then
      printf '%s' "$dir/.elixir-version"
      return 0
    fi
    dir="$(dirname "$dir")"
  done

  return 1
}

find_elixir_archive() {
  local version="$1"
  local -a otp_candidates=(29 28 27 26 25 24 23 22 21)
  local filename
  local url

  for otp in "${otp_candidates[@]}"; do
    filename="elixir-otp-${otp}.zip"
    url="https://github.com/elixir-lang/elixir/releases/download/v${version}/${filename}"
    if check_url_exists "$url"; then
      printf '%s' "$filename"
      return 0
    fi
  done

  return 1
}

detect_shell() {
  if [ -n "$ZSH_VERSION" ]; then
    printf '%s' "zsh"
  elif [ -n "$BASH_VERSION" ]; then
    printf '%s' "bash"
  elif [ -n "$KSH_VERSION" ]; then
    printf '%s' "sh"
  elif [ -n "$SHELL" ]; then
    case "${SHELL##*/}" in
      bash|zsh|sh)
        printf '%s' "${SHELL##*/}"
        ;;
      *)
        printf '%s' "sh"
        ;;
    esac
  else
    printf '%s' "sh"
  fi
}

output_init_script() {
  cat <<'EOF'
export EXENV_ROOT="${HOME}/.exenv"

_exenv_find_local_erlang_version_file() {
  local dir="$PWD"
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/.erlang-version" ]; then
      printf '%s' "$dir/.erlang-version"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
}

if version_file="$(_exenv_find_local_erlang_version_file)" && [ -n "$version_file" ]; then
  export PATH="$EXENV_ROOT/versions/erlang/$(cat "$version_file")/bin:$PATH"
elif [ -f "$EXENV_ROOT/erlang-version" ]; then
  export PATH="$EXENV_ROOT/versions/erlang/$(cat "$EXENV_ROOT/erlang-version")/bin:$PATH"
fi

export PATH="$EXENV_ROOT/bin:$EXENV_ROOT/shims:$PATH"
EOF
}

get_active_version() {
  local version
  local version_file

  version_file="$(find_local_version_file)" || true
  if [ -n "$version_file" ]; then
    version="$(cat "$version_file")"
  elif [ -f "${EXENV_ROOT}/version" ]; then
    version="$(cat "${EXENV_ROOT}/version")"
  fi

  printf '%s' "$version"
}

find_local_erlang_version_file() {
  local dir="$PWD"

  while [ "$dir" != "/" ]; do
    if [ -f "$dir/.erlang-version" ]; then
      printf '%s' "$dir/.erlang-version"
      return 0
    fi
    dir="$(dirname "$dir")"
  done

  return 1
}

get_active_erlang_version() {
  local version_file

  version_file="$(find_local_erlang_version_file)" || true
  if [ -n "$version_file" ]; then
    cat "$version_file"
    return 0
  elif [ -f "${EXENV_ROOT}/erlang-version" ]; then
    cat "${EXENV_ROOT}/erlang-version"
    return 0
  fi
  return 1
}

find_erlang_archive() {
  local version="$1"
  local filename="otp_src_${version}.tar.gz"
  local url="https://github.com/erlang/otp/releases/download/OTP-${version}/${filename}"

  if check_url_exists "$url"; then
    printf '%s' "$filename"
    return 0
  fi

  return 1
}

list_remote_versions() {
  local url="https://api.github.com/repos/elixir-lang/elixir/tags?per_page=100"
  local tmpfile

  if ! command_exists curl && ! command_exists wget; then
    echo "Error: 'curl' or 'wget' is required to fetch remote version data."
    return 1
  fi

  tmpfile="$(mktemp /tmp/exenv-releases.XXXXXX)"
  trap 'rm -f "$tmpfile"' EXIT

  if ! download_file "$url" "$tmpfile"; then
    echo "Error: Failed to fetch remote tag information."
    return 1
  fi

  grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"' "$tmpfile" \
    | sed -E 's/.*"([^"]+)"/\1/' \
    | sed 's/^v//' \
    | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' \
    | sort -t. -k1,1n -k2,2n -k3,3n -u

  trap - EXIT
}

list_remote_erlang_versions() {
  local url="https://api.github.com/repos/erlang/otp/tags?per_page=200"
  local tmpfile

  if ! command_exists curl && ! command_exists wget; then
    echo "Error: 'curl' or 'wget' is required to fetch remote version data."
    return 1
  fi

  tmpfile="$(mktemp /tmp/exenv-erlang-releases.XXXXXX)"
  trap 'rm -f "$tmpfile"' EXIT

  if ! download_file "$url" "$tmpfile"; then
    echo "Error: Failed to fetch remote Erlang tag information."
    return 1
  fi

  grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"' "$tmpfile" \
    | sed -E 's/.*"([^"]+)"/\1/' \
    | sed 's/^OTP-//' \
    | grep -E '^[0-9]+(\.[0-9]+)*$' \
    | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n -u

  trap - EXIT
}

build_erlang_version() {
  local version="$1"
  local install_path="$2"
  local archive_name
  local url
  local tmpdir

  if ! command_exists tar || ! command_exists make || ! command_exists gcc; then
    echo "Error: Building Erlang requires tar, make, and gcc."
    return 1
  fi

  archive_name="$(find_erlang_archive "$version")"
  if [ -z "$archive_name" ]; then
    echo "Error: Could not find source archive for Erlang ${version}."
    return 1
  fi

  url="https://github.com/erlang/otp/releases/download/OTP-${version}/${archive_name}"
  tmpdir="$(mktemp -d /tmp/exenv-erangl-src.XXXXXX)"
  trap 'rm -rf "$tmpdir"' EXIT

  if ! download_file "$url" "$tmpdir/$archive_name"; then
    echo "Error: Failed to download ${url}."
    return 1
  fi

  tar -xzf "$tmpdir/$archive_name" -C "$tmpdir"
  if [ ! -d "$tmpdir/otp_src_${version}" ]; then
    echo "Error: Extracted Erlang source directory not found."
    return 1
  fi

  cd "$tmpdir/otp_src_${version}"
  ./configure --prefix="$install_path"

  local jobs
  jobs="$(getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 1)"
  make -j "$jobs"
  make install
  cd - >/dev/null

  rm -rf "$tmpdir"
  trap - EXIT
}

exenv_rehash() {
  echo "Rebuilding shims..."
  rm -rf "${EXENV_ROOT}/shims"
  mkdir -p "${EXENV_ROOT}/shims"

  find "${EXENV_ROOT}/versions" -path '*/bin/*' -type f -print0 | while IFS= read -r -d '' executable; do
    local fname
    fname=$(basename "$executable")
    echo "#!/usr/bin/env bash" > "${EXENV_ROOT}/shims/${fname}"
    echo "exec exenv exec ${fname} \"\$@\"" >> "${EXENV_ROOT}/shims/${fname}"
    chmod +x "${EXENV_ROOT}/shims/${fname}"
  done

  echo "Shims rebuilt."
}

# --- COMMANDS ---

case "$1" in
  init)
    if [ "$2" = "-" ] || [ -z "$2" ]; then
      shell_name="$(detect_shell)"
    else
      shell_name="$2"
    fi

    case "$shell_name" in
      bash|zsh|sh)
        output_init_script
        ;;
      *)
        echo "Error: Unsupported shell '$shell_name'. Supported: bash, zsh, sh." >&2
        exit 1
        ;;
    esac
    ;;

  install)
    if [ "$2" = "--list" ] || [ "$2" = "-l" ]; then
      list_remote_versions
      exit $?
    fi

    VERSION="$2"
    if [ -z "$VERSION" ]; then
      echo "Error: Please provide a version to install. Ex: exenv install 1.16.2"
      exit 1
    fi

    if ! command_exists unzip; then
      echo "Error: 'unzip' is required to extract Elixir archives."
      exit 1
    fi

    if ! command_exists erl && [ ! -d "${EXENV_ROOT}/versions/erlang" ]; then
      echo "Error: Erlang/OTP is required to run Elixir. Install an Erlang version with 'exenv erlang install <version>' or ensure 'erl' is on your PATH."
      exit 1
    fi

    INSTALL_PATH="${EXENV_ROOT}/versions/${VERSION}"
    if [ -d "$INSTALL_PATH" ]; then
      echo "Version ${VERSION} is already installed."
      exit 0
    fi

    ARCHIVE_NAME="$(find_elixir_archive "$VERSION")"
    if [ -z "$ARCHIVE_NAME" ]; then
      echo "Error: Could not find a prebuilt Elixir OTP archive for version ${VERSION}."
      exit 1
    fi

    URL="https://github.com/elixir-lang/elixir/releases/download/v${VERSION}/${ARCHIVE_NAME}"
    echo "Downloading Elixir v${VERSION} (${ARCHIVE_NAME})..."

    TMPFILE="$(mktemp /tmp/exenv-elixir.XXXXXX.zip)"
    trap 'rm -f "$TMPFILE"' EXIT
    if ! download_file "$URL" "$TMPFILE"; then
      echo "Error: Failed to download ${URL}."
      exit 1
    fi

    echo "Installing Elixir v${VERSION} to ${INSTALL_PATH}..."
    mkdir -p "$INSTALL_PATH"
    unzip -q "$TMPFILE" -d "$INSTALL_PATH"
    rm -f "$TMPFILE"
    trap - EXIT

    if [ -d "$INSTALL_PATH/bin" ]; then
      chmod +x "$INSTALL_PATH/bin"/* 2>/dev/null || true
    fi

    echo "Elixir v${VERSION} installed successfully."
    echo "Run 'exenv global ${VERSION}' or 'exenv local ${VERSION}' to activate this version."
    exenv_rehash
    ;;

  versions)
    echo "Installed versions:"
    ls -1 "${EXENV_ROOT}/versions"
    ;;

  list-remote)
    echo "Available remote versions:"
    list_remote_versions
    ;;

  global)
    VERSION="$2"
    if [ -z "$VERSION" ]; then
      echo "Error: Please provide a version to set as global."
      exit 1
    fi
    echo "Setting global version to ${VERSION}..."
    echo "$VERSION" > "${EXENV_ROOT}/version"
    ;;

  local)
    VERSION="$2"
    if [ -z "$VERSION" ]; then
      echo "Error: Please provide a version to set as local."
      exit 1
    fi
    echo "Setting local version to ${VERSION}..."
    echo "$VERSION" > ".elixir-version"
    ;;

  uninstall)
    VERSION="$2"
    if [ -z "$VERSION" ]; then
      echo "Error: Please provide a version to uninstall. Ex: exenv uninstall 1.16.2"
      exit 1
    fi

    INSTALL_PATH="${EXENV_ROOT}/versions/${VERSION}"
    if [ ! -d "$INSTALL_PATH" ]; then
      echo "Version ${VERSION} is not installed."
      exit 1
    fi

    rm -rf "$INSTALL_PATH"
    echo "Version ${VERSION} has been removed."
    exenv_rehash
    ;;

  which)
    COMMAND_NAME="$2"
    if [ -z "$COMMAND_NAME" ]; then
      echo "Error: Please provide a command name. Ex: exenv which elixir"
      exit 1
    fi

    VERSION="$(get_active_version)"
    if [ -z "$VERSION" ]; then
      echo "No Elixir version has been set. Use 'exenv global <version>'."
      exit 1
    fi

    REAL_EXECUTABLE="${EXENV_ROOT}/versions/${VERSION}/bin/${COMMAND_NAME}"
    if [ -x "$REAL_EXECUTABLE" ]; then
      echo "$REAL_EXECUTABLE"
    else
      echo "Error: Command '${COMMAND_NAME}' not found for version ${VERSION}."
      exit 1
    fi
    ;;

  version)
    VERSION="$(get_active_version)"
    if [ -z "$VERSION" ]; then
      echo "No Elixir version has been set. Use 'exenv global <version>'."
      exit 1
    fi
    echo "$VERSION"
    ;;

  rehash)
    exenv_rehash
    ;;

  erlang)
    if [ "$2" = "--list" ] || [ "$2" = "-l" ]; then
      list_remote_erlang_versions
      exit $?
    fi

    if [ "$2" = "install" ]; then
      ERLANG_VERSION="$3"
      if [ -z "$ERLANG_VERSION" ]; then
        echo "Error: Please provide a version to install. Ex: exenv erlang install 29.0"
        exit 1
      fi

      INSTALL_PATH="${EXENV_ROOT}/versions/erlang/${ERLANG_VERSION}"
      if [ -d "$INSTALL_PATH" ]; then
        echo "Erlang ${ERLANG_VERSION} is already installed."
        exit 0
      fi

      echo "Building and installing Erlang/OTP ${ERLANG_VERSION}..."
      build_erlang_version "$ERLANG_VERSION" "$INSTALL_PATH"
      echo "Erlang/OTP ${ERLANG_VERSION} installed to ${INSTALL_PATH}."
      exit $?
    fi

    if [ "$2" = "global" ]; then
      ERLANG_VERSION="$3"
      if [ -z "$ERLANG_VERSION" ]; then
        echo "Error: Please provide a version to set as global. Ex: exenv erlang global 29.0"
        exit 1
      fi
      echo "$ERLANG_VERSION" > "${EXENV_ROOT}/erlang-version"
      echo "Erlang global version set to ${ERLANG_VERSION}."
      exit 0
    fi

    if [ "$2" = "local" ]; then
      ERLANG_VERSION="$3"
      if [ -z "$ERLANG_VERSION" ]; then
        echo "Error: Please provide a version to set as local. Ex: exenv erlang local 29.0"
        exit 1
      fi
      echo "$ERLANG_VERSION" > ".erlang-version"
      echo "Erlang local version set to ${ERLANG_VERSION}."
      exit 0
    fi

    if [ "$2" = "uninstall" ]; then
      ERLANG_VERSION="$3"
      if [ -z "$ERLANG_VERSION" ]; then
        echo "Error: Please provide a version to uninstall. Ex: exenv erlang uninstall 29.0"
        exit 1
      fi
      INSTALL_PATH="${EXENV_ROOT}/versions/erlang/${ERLANG_VERSION}"
      if [ ! -d "$INSTALL_PATH" ]; then
        echo "Erlang version ${ERLANG_VERSION} is not installed."
        exit 1
      fi
      rm -rf "$INSTALL_PATH"
      echo "Erlang version ${ERLANG_VERSION} removed."
      exit 0
    fi

    echo "Usage: exenv erlang <subcommand> [args]"
    echo "Subcommands: install <version>, --list, global <version>, local <version>, uninstall <version>"
    exit 1
    ;;

  exec)
    COMMAND_NAME="$2"
    shift 2

    # Use helper which safely resolves local or global version
    VERSION="$(get_active_version)"

    if [ -z "$VERSION" ]; then
      echo "No Elixir version has been set. Use 'exenv global <version>'."
      exit 1
    fi

    REAL_EXECUTABLE="${EXENV_ROOT}/versions/${VERSION}/bin/${COMMAND_NAME}"
    if [ -f "$REAL_EXECUTABLE" ]; then
      exec "$REAL_EXECUTABLE" "$@"
    else
      echo "Error: Command '${COMMAND_NAME}' not found in version ${VERSION}."
      exit 1
    fi
    ;;

  *)
    echo "Usage: exenv <command> [<options>]"
    echo "Commands:"
    echo "  init [-|bash|zsh|sh] - Outputs shell init code for exenv"
    echo "  install <version>    - Installs a version of Elixir"
    echo "  install --list       - Lists available remote Elixir versions"
    echo "  versions             - Lists installed versions"
    echo "  list-remote          - Alias for 'install --list'"
    echo "  erlang <subcommand>  - Manage Erlang/OTP versions"
    echo "  uninstall <version>  - Removes an installed Elixir version"
    echo "  global <version>     - Sets the global version"
    echo "  local <version>      - Sets the local version (for the current directory)"
    echo "  version              - Shows the active Elixir version"
    echo "  which <command>      - Shows the full path of a command for the active version"
    echo "  rehash               - Rebuilds the shims"
    ;;
esac
